---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Отзывы клиентов"
  description="Отзывы наших клиентов о качестве работы и обслуживания компании Теплый дом в Евпатории."
>
  <Header />

  <main class="py-12">
    <div class="container-custom">
      <h1 class="mb-8">Отзывы клиентов</h1>

      <div class="text-center py-16">
        <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
        </svg>
        <h2 class="text-2xl font-semibold text-gray-700 mb-4">Отзывы скоро появятся</h2>
        <p class="text-gray-600 mb-8">
          Мы работаем над добавлением отзывов наших клиентов
        </p>
        <a href="/contacts" class="btn-primary">
          Оставить отзыв
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
