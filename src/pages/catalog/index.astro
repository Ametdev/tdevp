---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const products = allProducts.sort((a, b) => a.data.order - b.data.order);

const categories = [
  'Все категории',
  'Стеклянные конструкции',
  'Окна и защита',
  'Двери',
  'Подоконники',
  'Кондиционеры',
  'Жалюзи и шторы'
];
---

<BaseLayout
  title="Каталог товаров и услуг"
  description="Полный каталог стеклянных конструкций, окон, дверей, жалюзи и кондиционеров в Евпатории. Качественные материалы по доступным ценам."
>
  <Header />

  <main class="py-12">
    <div class="container-custom">
      <!-- Page Header -->
      <div class="mb-12">
        <h1 class="mb-4">Каталог товаров и услуг</h1>
        <p class="text-gray-600 text-lg">
          Выберите категорию или воспользуйтесь поиском для быстрого поиска нужного товара
        </p>
      </div>

      <!-- Filters -->
      <div class="mb-8">
        <div class="bg-white rounded-lg shadow-md p-6">
          <!-- Category Filter -->
          <div class="mb-6">
            <label class="block text-sm font-semibold text-gray-700 mb-3">
              Категория
            </label>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <button
                  class="category-filter px-4 py-2 rounded-lg border-2 transition-colors"
                  data-category={category}
                >
                  {category}
                </button>
              ))}
            </div>
          </div>

          <!-- Search -->
          <div class="mb-6">
            <label for="search" class="block text-sm font-semibold text-gray-700 mb-3">
              Поиск
            </label>
            <input
              type="text"
              id="search"
              placeholder="Введите название товара..."
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:border-primary-600 focus:outline-none"
            />
          </div>

          <!-- Sort -->
          <div>
            <label for="sort" class="block text-sm font-semibold text-gray-700 mb-3">
              Сортировка
            </label>
            <select
              id="sort"
              class="px-4 py-2 border-2 border-gray-300 rounded-lg focus:border-primary-600 focus:outline-none"
            >
              <option value="default">По умолчанию</option>
              <option value="price-asc">Цена: по возрастанию</option>
              <option value="price-desc">Цена: по убыванию</option>
              <option value="name">По названию</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Products Grid -->
      <div id="products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
          <div
            class="product-item"
            data-category={product.data.category}
            data-title={product.data.title.toLowerCase()}
            data-price={product.data.price}
          >
            <ProductCard
              title={product.data.title}
              description={product.data.description}
              price={product.data.price}
              priceUnit={product.data.priceUnit}
              priceNote={product.data.priceNote}
              image={product.data.image}
              slug={product.slug}
              inStock={product.data.inStock}
              featured={product.data.featured}
            />
          </div>
        ))}
      </div>

      <!-- No Results -->
      <div id="no-results" class="hidden text-center py-12">
        <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h3 class="text-xl font-semibold text-gray-700 mb-2">Ничего не найдено</h3>
        <p class="text-gray-500">Попробуйте изменить параметры поиска</p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  let currentCategory = 'Все категории';
  let currentSearch = '';
  let currentSort = 'default';

  const categoryButtons = document.querySelectorAll('.category-filter');
  const searchInput = document.getElementById('search') as HTMLInputElement;
  const sortSelect = document.getElementById('sort') as HTMLSelectElement;
  const productsGrid = document.getElementById('products-grid');
  const noResults = document.getElementById('no-results');

  function updateActiveCategory() {
    categoryButtons.forEach(btn => {
      const category = btn.getAttribute('data-category');
      if (category === currentCategory) {
        btn.classList.add('bg-primary-600', 'text-white', 'border-primary-600');
        btn.classList.remove('border-gray-300', 'text-gray-700', 'hover:border-primary-600');
      } else {
        btn.classList.remove('bg-primary-600', 'text-white', 'border-primary-600');
        btn.classList.add('border-gray-300', 'text-gray-700', 'hover:border-primary-600');
      }
    });
  }

  function filterAndSort() {
    const items = Array.from(document.querySelectorAll('.product-item')) as HTMLElement[];
    let visibleCount = 0;

    // Filter
    items.forEach(item => {
      const category = item.getAttribute('data-category');
      const title = item.getAttribute('data-title') || '';

      const categoryMatch = currentCategory === 'Все категории' || category === currentCategory;
      const searchMatch = currentSearch === '' || title.includes(currentSearch.toLowerCase());

      if (categoryMatch && searchMatch) {
        item.style.display = 'block';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    // Sort visible items
    const visibleItems = items.filter(item => item.style.display !== 'none');

    if (currentSort !== 'default') {
      visibleItems.sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-price') || '0');
        const priceB = parseFloat(b.getAttribute('data-price') || '0');
        const titleA = a.getAttribute('data-title') || '';
        const titleB = b.getAttribute('data-title') || '';

        switch (currentSort) {
          case 'price-asc':
            return priceA - priceB;
          case 'price-desc':
            return priceB - priceA;
          case 'name':
            return titleA.localeCompare(titleB);
          default:
            return 0;
        }
      });

      // Reorder in DOM
      visibleItems.forEach(item => {
        productsGrid?.appendChild(item);
      });
    }

    // Show/hide no results
    if (visibleCount === 0) {
      noResults?.classList.remove('hidden');
    } else {
      noResults?.classList.add('hidden');
    }
  }

  // Category filter
  categoryButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      currentCategory = btn.getAttribute('data-category') || 'Все категории';
      updateActiveCategory();
      filterAndSort();
    });
  });

  // Search
  searchInput?.addEventListener('input', (e) => {
    currentSearch = (e.target as HTMLInputElement).value;
    filterAndSort();
  });

  // Sort
  sortSelect?.addEventListener('change', (e) => {
    currentSort = (e.target as HTMLSelectElement).value;
    filterAndSort();
  });

  // Initialize
  updateActiveCategory();
</script>
