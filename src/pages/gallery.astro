---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const galleryItems = await getCollection('gallery');
const sortedGallery = galleryItems.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Галерея работ"
  description="Фотографии выполненных проектов компании Теплый дом - стеклянные конструкции, окна, двери."
>
  <Header />

  <main class="py-12">
    <div class="container-custom">
      <h1 class="mb-8">Галерея наших работ</h1>

      {sortedGallery.length === 0 ? (
        <div class="text-center py-16">
          <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <h2 class="text-2xl font-semibold text-gray-700 mb-4">Галерея скоро появится</h2>
          <p class="text-gray-600 mb-8">
            Мы работаем над добавлением фотографий наших проектов
          </p>
          <a href="/catalog" class="btn-primary">
            Смотреть каталог
          </a>
        </div>
      ) : (
        <div class="space-y-12">
          {sortedGallery.map(async (item) => {
            const { Content } = await item.render();
            return (
              <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <div class="p-6 border-b border-gray-200">
                  <div class="flex items-center justify-between">
                    <div>
                      <h2 class="text-2xl font-bold text-gray-900">{item.data.title}</h2>
                      <p class="text-sm text-gray-500 mt-1">
                        {item.data.date.toLocaleDateString('ru-RU', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric'
                        })}
                      </p>
                    </div>
                    <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm font-medium">
                      {item.data.category}
                    </span>
                  </div>
                  {item.body && (
                    <div class="mt-4 text-gray-700 prose prose-sm max-w-none">
                      <Content />
                    </div>
                  )}
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 p-6">
                  {item.data.images.map((image: string) => (
                    <div class="aspect-square overflow-hidden rounded-lg bg-gray-100">
                      <img
                        src={image}
                        alt={item.data.title}
                        class="w-full h-full object-cover hover:scale-110 transition-transform duration-300 cursor-pointer"
                        loading="lazy"
                      />
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </main>

  <Footer />
</BaseLayout>
