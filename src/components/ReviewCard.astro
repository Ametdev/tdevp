---
interface Props {
  author: string;
  date: Date;
  rating: number;
  avatar?: string;
  content: string;
}

const { author, date, rating, avatar, content } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('ru-RU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<article class="bg-white rounded-lg shadow-md p-6">
  <div class="flex items-start space-x-4">
    <!-- Avatar -->
    <div class="flex-shrink-0">
      {avatar ? (
        <img
          src={avatar}
          alt={author}
          class="w-12 h-12 rounded-full object-cover"
        />
      ) : (
        <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center">
          <span class="text-primary-600 font-bold text-lg">
            {author.charAt(0).toUpperCase()}
          </span>
        </div>
      )}
    </div>

    <!-- Content -->
    <div class="flex-1">
      <div class="flex items-center justify-between mb-2">
        <h3 class="font-semibold text-gray-900">{author}</h3>
        <time class="text-sm text-gray-500">{formattedDate}</time>
      </div>

      <!-- Rating -->
      <div class="flex items-center mb-3">
        {Array.from({ length: 5 }).map((_, i) => (
          <svg
            class={`w-5 h-5 ${i < rating ? 'text-yellow-400' : 'text-gray-300'}`}
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>

      <!-- Review Text -->
      <p class="text-gray-700 leading-relaxed">{content}</p>
    </div>
  </div>
</article>
