---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Галерея работ"
  description="Фотографии выполненных проектов компании Теплый дом - стеклянные конструкции, окна, двери."
>
  <Header />

  <main class="py-12">
    <div class="container-custom">
      <h1 class="mb-8">Галерея наших работ</h1>

      <div class="text-center py-16">
        <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <h2 class="text-2xl font-semibold text-gray-700 mb-4">Галерея скоро появится</h2>
        <p class="text-gray-600 mb-8">
          Мы работаем над добавлением фотографий наших проектов
        </p>
        <a href="/catalog" class="btn-primary">
          Смотреть каталог
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
