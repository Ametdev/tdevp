---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Оставить отзыв"
  description="Оставьте отзыв о работе компании Теплый дом. Ваше мнение важно для нас."
>
  <Header />

  <main class="py-12">
    <div class="container-custom">
      <div class="max-w-2xl mx-auto">
        <h1 class="mb-4">Оставить отзыв</h1>
        <p class="text-gray-600 mb-8">
          Мы ценим ваше мнение! Поделитесь своим опытом работы с нами.
        </p>

        <div class="bg-white rounded-lg shadow-md p-8">
          <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
                Ваше имя *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:border-primary-600 focus:outline-none"
                placeholder="Иван Иванов"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:border-primary-600 focus:outline-none"
                placeholder="ivan@example.com"
              />
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">
                Оценка *
              </label>
              <div id="rating-stars" class="flex space-x-2">
                {[1, 2, 3, 4, 5].map((star) => (
                  <label class="cursor-pointer">
                    <input
                      type="radio"
                      name="rating"
                      value={star}
                      required
                      class="sr-only rating-input"
                      data-rating={star}
                    />
                    <svg
                      class="w-10 h-10 text-gray-300 transition-colors rating-star"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <label for="review" class="block text-sm font-semibold text-gray-700 mb-2">
                Ваш отзыв *
              </label>
              <textarea
                id="review"
                name="review"
                rows="6"
                required
                class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:border-primary-600 focus:outline-none"
                placeholder="Расскажите о вашем опыте работы с нами..."
              ></textarea>
            </div>

            <div class="flex items-start space-x-3">
              <input
                type="checkbox"
                id="consent"
                name="consent"
                required
                class="mt-1 w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500"
              />
              <label for="consent" class="text-sm text-gray-600">
                Я согласен на обработку персональных данных и публикацию отзыва на сайте *
              </label>
            </div>

            <div class="flex space-x-4">
              <button type="submit" class="btn-primary flex-1">
                Отправить отзыв
              </button>
              <a href="/reviews" class="btn-secondary flex-1 text-center">
                Отмена
              </a>
            </div>

            <p class="text-sm text-gray-600">
              * Обязательные поля
            </p>

            <p class="text-xs text-gray-500 mt-4 text-center">
              Обратите внимание: загрузка отзывов на сайт может занять до 24 часов в связи с модерацией.
            </p>
          </form>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const ratingInputs = document.querySelectorAll('.rating-input');
  const ratingStars = document.querySelectorAll('.rating-star');

  function updateStars(rating: number) {
    ratingStars.forEach((star, index) => {
      if (index < rating) {
        star.classList.remove('text-gray-300');
        star.classList.add('text-yellow-400');
      } else {
        star.classList.remove('text-yellow-400');
        star.classList.add('text-gray-300');
      }
    });
  }

  ratingInputs.forEach((input) => {
    input.addEventListener('change', (e) => {
      const rating = parseInt((e.target as HTMLInputElement).dataset.rating || '0');
      updateStars(rating);
    });
  });

  // Hover effect
  ratingStars.forEach((star, index) => {
    star.addEventListener('mouseenter', () => {
      updateStars(index + 1);
    });
  });

  document.getElementById('rating-stars')?.addEventListener('mouseleave', () => {
    const checkedInput = document.querySelector('.rating-input:checked') as HTMLInputElement;
    if (checkedInput) {
      const rating = parseInt(checkedInput.dataset.rating || '0');
      updateStars(rating);
    } else {
      updateStars(0);
    }
  });
</script>
